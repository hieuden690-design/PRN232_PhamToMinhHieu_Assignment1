@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("AccountName");
    var userEmail = HttpContextAccessor.HttpContext?.Session.GetString("AccountEmail");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <i class="bi bi-newspaper me-2"></i>FUNews Management
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>Home News
                            </a>
                        </li>

                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Accounts">
                                    <i class="bi bi-people me-1"></i>Account Management
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Report">
                                    <i class="bi bi-bar-chart-line me-1"></i>Statistics Report
                                </a>
                            </li>
                        }
                        else if (role == "Staff")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Categories">
                                    <i class="bi bi-tags me-1"></i>Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Articles">
                                    <i class="bi bi-file-earmark-text me-1"></i>Articles Management
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/History">
                                    <i class="bi bi-clock-history me-1"></i>My Articles History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Profile">
                                    <i class="bi bi-person-circle me-1"></i>My Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item text-white me-3">
                                <span class="badge bg-light text-primary me-1">@role</span>
                                <span>Hello, <strong>@userName</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm" asp-page="/Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm fw-semibold" asp-page="/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto bg-light">
        <div class="container text-center">
            &copy; 2026 - FUNews Management System - PRN232 Assignment 01
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>