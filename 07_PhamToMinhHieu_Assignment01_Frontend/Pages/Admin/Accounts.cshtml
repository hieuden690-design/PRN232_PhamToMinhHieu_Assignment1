@page
@model _07_PhamToMinhHieu_Assignment01_Frontend.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Account Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary"><i class="bi bi-people-fill me-2"></i>Account Management</h2>
        <p class="text-muted mb-0">Administer system staff and lecturer accounts.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAccountModal">
        <i class="bi bi-person-plus-fill me-1"></i>Create New Account
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search Bar -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search accounts by name or email..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="/Admin/Accounts" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Accounts Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Account Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Accounts.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>No accounts found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in Model.Accounts)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@account.AccountId</td>
                                <td>@account.AccountName</td>
                                <td>@account.AccountEmail</td>
                                <td>
                                    @if (account.AccountRole == 1)
                                    {
                                        <span class="badge bg-success">Staff (1)</span>
                                    }
                                    else if (account.AccountRole == 2)
                                    {
                                        <span class="badge bg-info text-dark">Lecturer (2)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Other (@account.AccountRole)</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit"
                                            data-id="@account.AccountId"
                                            data-name="@account.AccountName"
                                            data-email="@account.AccountEmail"
                                            data-role="@account.AccountRole">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-delete"
                                            data-id="@account.AccountId"
                                            data-name="@account.AccountName">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= CREATE MODAL POPUP ================= -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createAccountModalLabel"><i class="bi bi-person-plus-fill me-2"></i>Create New Account</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Account Name</label>
                        <input asp-for="AccountForm.AccountName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input asp-for="AccountForm.AccountEmail" type="email" class="form-control" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Role</label>
                        <select asp-for="AccountForm.AccountRole" class="form-select" required>
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input asp-for="AccountForm.AccountPassword" type="password" class="form-control" required maxlength="70" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= UPDATE MODAL POPUP ================= -->
<div class="modal fade" id="updateAccountModal" tabindex="-1" aria-labelledby="updateAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="updateAccountModalLabel"><i class="bi bi-pencil-square me-2"></i>Update Account</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editAccountId" asp-for="AccountForm.AccountId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Account Name</label>
                        <input id="editAccountName" asp-for="AccountForm.AccountName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input id="editAccountEmail" asp-for="AccountForm.AccountEmail" type="email" class="form-control" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Role</label>
                        <select id="editAccountRole" asp-for="AccountForm.AccountRole" class="form-select" required>
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">New Password (leave empty to keep unchanged)</label>
                        <input asp-for="AccountForm.AccountPassword" type="password" class="form-control" maxlength="70" placeholder="Optional new password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= DELETE CONFIRMATION MODAL ================= -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteConfirmModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteAccountId" name="id" />
                    <p>Are you sure you want to delete account: <strong id="deleteAccountName"></strong>?</p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-shield-exclamation me-1"></i>Note: An account cannot be deleted if it has already created any news articles.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Edit modal population
            $('.btn-edit').on('click', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var email = $(this).data('email');
                var role = $(this).data('role');

                $('#editAccountId').val(id);
                $('#editAccountName').val(name);
                $('#editAccountEmail').val(email);
                $('#editAccountRole').val(role);

                var modal = new bootstrap.Modal(document.getElementById('updateAccountModal'));
                modal.show();
            });

            // Delete confirm modal population
            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');

                $('#deleteAccountId').val(id);
                $('#deleteAccountName').text(name + ' (#' + id + ')');

                var modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                modal.show();
            });
        });
    </script>
}
