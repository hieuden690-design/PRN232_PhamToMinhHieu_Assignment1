@page
@model _07_PhamToMinhHieu_Assignment01_Frontend.Pages.IndexModel
@{
    ViewData["Title"] = "Public News";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold text-primary"><i class="bi bi-newspaper me-2"></i>Latest University News</h2>
        <p class="text-muted">Stay up to date with the latest campus announcements, academic programs, and events.</p>
    </div>
    <div class="col-md-4">
        <form method="get" class="d-flex mt-2">
            <div class="input-group">
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search news..." />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="/Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Articles.Any())
{
    <div class="alert alert-info py-4 text-center">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        <h5>No active news articles found.</h5>
        <p class="mb-0">Please check back later or try a different search keyword.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var article in Model.Articles)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">@(article.CategoryName ?? "General")</span>
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@(article.CreatedDate?.ToString("MMM dd, yyyy") ?? "N/A")</small>
                        </div>
                        <h5 class="card-title fw-bold text-dark">@(article.NewsTitle ?? article.Headline)</h5>
                        <p class="card-text text-secondary mb-3">@article.Headline</p>
                        
                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="bi bi-person me-1"></i>By: @(article.CreatedByName ?? "FU Staff")
                            </small>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#articleModal_@article.NewsArticleId">
                                Read Story <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>

                        @if (article.Tags.Any())
                        {
                            <div class="mt-2">
                                @foreach (var tag in article.Tags)
                                {
                                    <span class="badge bg-light text-dark border me-1">#@tag.TagName</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Modal for Story Details -->
                <div class="modal fade" id="articleModal_@article.NewsArticleId" tabindex="-1" aria-labelledby="modalLabel_@article.NewsArticleId" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header bg-light">
                                <div>
                                    <span class="badge bg-primary mb-1">@(article.CategoryName ?? "General")</span>
                                    <h5 class="modal-title fw-bold" id="modalLabel_@article.NewsArticleId">@(article.NewsTitle ?? article.Headline)</h5>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="text-muted small mb-3 pb-2 border-bottom d-flex justify-content-between">
                                    <span><strong>Source:</strong> @(string.IsNullOrEmpty(article.NewsSource) ? "N/A" : article.NewsSource)</span>
                                    <span><strong>Published:</strong> @(article.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</span>
                                    <span><strong>Author:</strong> @(article.CreatedByName ?? "FU Staff")</span>
                                </div>
                                <div class="lead fs-6 fw-semibold text-secondary mb-3">
                                    @article.Headline
                                </div>
                                <div class="article-content" style="white-space: pre-line; line-height: 1.7;">
                                    @article.NewsContent
                                </div>
                                @if (article.Tags.Any())
                                {
                                    <div class="mt-4 pt-3 border-top">
                                        <span class="fw-bold me-2">Tags:</span>
                                        @foreach (var tag in article.Tags)
                                        {
                                            <span class="badge bg-secondary me-1">#@tag.TagName</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
