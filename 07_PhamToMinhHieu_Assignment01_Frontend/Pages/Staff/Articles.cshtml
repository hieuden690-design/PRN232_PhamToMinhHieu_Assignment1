@page
@model _07_PhamToMinhHieu_Assignment01_Frontend.Pages.Staff.ArticlesModel
@{
    ViewData["Title"] = "News Articles Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary"><i class="bi bi-file-earmark-text-fill me-2"></i>News Articles Management</h2>
        <p class="text-muted mb-0">Create, publish, update, and manage news stories and tags.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createArticleModal">
        <i class="bi bi-file-earmark-plus-fill me-1"></i>Create News Article
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search Bar -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by title, headline, or content..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="/Staff/Articles" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Articles Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Title / Headline</th>
                        <th>Category</th>
                        <th>Author</th>
                        <th>Created Date</th>
                        <th>Status</th>
                        <th>Tags</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Articles.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>No articles found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var article in Model.Articles)
                        {
                            var tagIdsJson = System.Text.Json.JsonSerializer.Serialize(article.Tags.Select(t => t.TagId));
                            <tr>
                                <td class="ps-3 fw-bold">#@article.NewsArticleId</td>
                                <td>
                                    <div class="fw-bold">@(article.NewsTitle ?? article.Headline)</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@article.Headline</small>
                                </td>
                                <td><span class="badge bg-secondary">@(article.CategoryName ?? "N/A")</span></td>
                                <td>@(article.CreatedByName ?? "N/A")</td>
                                <td><small>@(article.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")</small></td>
                                <td>
                                    @if (article.NewsStatus == true)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var tag in article.Tags)
                                    {
                                        <span class="badge bg-light text-dark border me-1">#@tag.TagName</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-outline-primary btn-sm me-1 btn-edit"
                                            data-id="@article.NewsArticleId"
                                            data-title="@article.NewsTitle"
                                            data-headline="@article.Headline"
                                            data-content="@article.NewsContent"
                                            data-source="@article.NewsSource"
                                            data-category="@article.CategoryId"
                                            data-status="@(article.NewsStatus == true ? "true" : "false")"
                                            data-tags='@tagIdsJson'>
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-delete"
                                            data-id="@article.NewsArticleId"
                                            data-title="@(article.NewsTitle ?? article.Headline)">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= CREATE ARTICLE MODAL ================= -->
<div class="modal fade" id="createArticleModal" tabindex="-1" aria-labelledby="createArticleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createArticleModalLabel"><i class="bi bi-file-earmark-plus-fill me-2"></i>Create News Article</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Article ID <span class="text-danger">*</span></label>
                            <input asp-for="ArticleForm.NewsArticleId" class="form-control" required maxlength="20" placeholder="e.g. NA101" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                            <select asp-for="ArticleForm.CategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">News Title</label>
                            <input asp-for="ArticleForm.NewsTitle" class="form-control" maxlength="400" placeholder="Main title" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Headline <span class="text-danger">*</span></label>
                            <input asp-for="ArticleForm.Headline" class="form-control" required maxlength="150" placeholder="Brief summary headline" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">News Content</label>
                            <textarea asp-for="ArticleForm.NewsContent" class="form-control" rows="5" maxlength="4000" placeholder="Detailed content..."></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">News Source</label>
                            <input asp-for="ArticleForm.NewsSource" class="form-control" maxlength="400" placeholder="Source URL or organization" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" asp-for="ArticleForm.NewsStatus" checked id="createNewsStatus" />
                                <label class="form-check-label fw-bold" for="createNewsStatus">Active / Published</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Tags</label>
                            <div class="border rounded p-2 d-flex flex-wrap gap-3 bg-light">
                                @foreach (var tag in Model.AvailableTags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ArticleForm.SelectedTagIds" value="@tag.TagId" id="create_tag_@tag.TagId" />
                                        <label class="form-check-label" for="create_tag_@tag.TagId">@tag.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Create Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= UPDATE ARTICLE MODAL ================= -->
<div class="modal fade" id="updateArticleModal" tabindex="-1" aria-labelledby="updateArticleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="updateArticleModalLabel"><i class="bi bi-pencil-square me-2"></i>Update News Article</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Article ID</label>
                            <input id="editArticleId" asp-for="ArticleForm.NewsArticleId" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                            <select id="editArticleCategory" asp-for="ArticleForm.CategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">News Title</label>
                            <input id="editArticleTitle" asp-for="ArticleForm.NewsTitle" class="form-control" maxlength="400" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Headline <span class="text-danger">*</span></label>
                            <input id="editArticleHeadline" asp-for="ArticleForm.Headline" class="form-control" required maxlength="150" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">News Content</label>
                            <textarea id="editArticleContent" asp-for="ArticleForm.NewsContent" class="form-control" rows="5" maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">News Source</label>
                            <input id="editArticleSource" asp-for="ArticleForm.NewsSource" class="form-control" maxlength="400" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" id="editArticleStatus" asp-for="ArticleForm.NewsStatus" />
                                <label class="form-check-label fw-bold" for="editArticleStatus">Active / Published</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Tags</label>
                            <div class="border rounded p-2 d-flex flex-wrap gap-3 bg-light" id="editTagsContainer">
                                @foreach (var tag in Model.AvailableTags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input edit-tag-check" type="checkbox" name="ArticleForm.SelectedTagIds" value="@tag.TagId" id="edit_tag_@tag.TagId" />
                                        <label class="form-check-label" for="edit_tag_@tag.TagId">@tag.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= DELETE CONFIRMATION MODAL ================= -->
<div class="modal fade" id="deleteArticleModal" tabindex="-1" aria-labelledby="deleteArticleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteArticleModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteArticleId" name="id" />
                    <p>Are you sure you want to delete article: <strong id="deleteArticleTitle"></strong>?</p>
                    <p class="text-danger small mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Edit modal population
            $('.btn-edit').on('click', function () {
                var id = $(this).data('id');
                var title = $(this).data('title');
                var headline = $(this).data('headline');
                var content = $(this).data('content');
                var source = $(this).data('source');
                var category = $(this).data('category');
                var status = $(this).data('status') === true || $(this).data('status') === 'true';
                var tags = $(this).data('tags'); // array of tag IDs

                $('#editArticleId').val(id);
                $('#editArticleTitle').val(title);
                $('#editArticleHeadline').val(headline);
                $('#editArticleContent').val(content);
                $('#editArticleSource').val(source);
                $('#editArticleCategory').val(category);
                $('#editArticleStatus').prop('checked', status);

                // Reset and check tags
                $('.edit-tag-check').prop('checked', false);
                if (Array.isArray(tags)) {
                    tags.forEach(function (tagId) {
                        $('#edit_tag_' + tagId).prop('checked', true);
                    });
                }

                var modal = new bootstrap.Modal(document.getElementById('updateArticleModal'));
                modal.show();
            });

            // Delete confirm modal population
            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');
                var title = $(this).data('title');

                $('#deleteArticleId').val(id);
                $('#deleteArticleTitle').text(title + ' (#' + id + ')');

                var modal = new bootstrap.Modal(document.getElementById('deleteArticleModal'));
                modal.show();
            });
        });
    </script>
}
